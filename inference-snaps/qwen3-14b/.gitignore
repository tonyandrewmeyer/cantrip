# Snap build artefacts.
parts/
stage/
prime/
partitions/
squashfs-root
*.snap
*.comp

# Model weights cache — fetched at snap build time (by snapcraft) or
# locally (by prepare-models.sh / smoke-server.sh) from Hugging Face.
# Not committed because the Q4_K_M GGUF is ~9 GB and HF is the source
# of truth.
/cache/
*.gguf

# Prebuilt llama.cpp engine tarballs fetched by scripts/smoke-server.sh
# into engines/llamacpp-<variant>-<tag>/.  The committed snap engines
# (engines/cpu/, engines/nvidia-gpu/, engines/amd-gpu/) stay tracked.
engines/llamacpp-*/

# Local snapcraft.yaml symlink (some workflows symlink snap/snapcraft.yaml here).
/snapcraft.yaml

# snapcraft-pack.log — locally-tee'd build log.
snapcraft-pack.log
