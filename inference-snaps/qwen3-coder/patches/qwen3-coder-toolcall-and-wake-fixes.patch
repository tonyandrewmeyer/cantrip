From a76c5da8e640325db6b2d0085d8ab775a976b259 Mon Sep 17 00:00:00 2001
From: Tony Meyer <tony.meyer@canonical.com>
Date: Fri, 12 Jun 2026 16:17:34 +1200
Subject: [PATCH] qwen3-coder fixes: opener-tolerant tool-call parsing +
 sleep-wake reload

---
 common/chat-auto-parser-generator.cpp | 29 +++++++++++++++++++++++++--
 tools/server/server-context.cpp       | 21 ++++++++++++++++++-
 2 files changed, 47 insertions(+), 3 deletions(-)

diff --git a/common/chat-auto-parser-generator.cpp b/common/chat-auto-parser-generator.cpp
index 2fac0ea5..080c6a87 100644
--- a/common/chat-auto-parser-generator.cpp
+++ b/common/chat-auto-parser-generator.cpp
@@ -81,6 +81,17 @@ common_chat_params peg_generator::generate_parser(const common_chat_template &
             data.grammar_triggers = {
                 { COMMON_GRAMMAR_TRIGGER_TYPE_WORD, trigger_marker }
             };
+            // Some models (e.g. Qwen3-Coder) intermittently omit the per-call
+            // opener and start directly with the function tag; the parser
+            // accepts that (see build_tool_parser_tag_tagged), so grammar
+            // enforcement must also trigger on the function tag itself.
+            const auto & fn_prefix = autoparser.tools.function.name_prefix;
+            if (autoparser.tools.format.mode == tool_format::TAG_WITH_TAGGED &&
+                autoparser.tools.format.section_start.empty() &&
+                !fn_prefix.empty() && fn_prefix.front() == '<' &&
+                fn_prefix != autoparser.tools.format.per_call_start) {
+                data.grammar_triggers.push_back({ COMMON_GRAMMAR_TRIGGER_TYPE_WORD, fn_prefix });
+            }
         }
     }
 
@@ -435,8 +446,20 @@ common_peg_parser analyze_tools::build_tool_parser_tag_tagged(parser_build_conte
 
     common_peg_parser tool_calls = p.eps();
 
+    // Some models (e.g. Qwen3-Coder) intermittently omit the per-call opener
+    // (e.g. "<tool_call>\n") and start directly with the function tag
+    // ("<function=..."). When there is no section marker and the function tag
+    // is a distinct tag-shaped marker, accept the opener as optional.
+    const bool opener_optional = format.section_start.empty() &&
+                                 !format.per_call_start.empty() &&
+                                 !function.name_prefix.empty() &&
+                                 function.name_prefix.front() == '<' &&
+                                 function.name_prefix != format.per_call_start;
+
     if (!format.per_call_start.empty()) {
-        auto wrapped_call = format.per_call_start + p.space() + tool_choice + p.space() + format.per_call_end;
+        auto call_start = opener_optional ? p.optional(p.literal(format.per_call_start))
+                                          : p.literal(format.per_call_start);
+        auto wrapped_call = call_start + p.space() + tool_choice + p.space() + format.per_call_end;
         if (inputs.parallel_tool_calls) {
             tool_calls = p.trigger_rule("tool-call", wrapped_call + p.zero_or_more(p.space() + wrapped_call) + p.space());
         } else {
@@ -465,7 +488,9 @@ common_peg_parser analyze_tools::build_tool_parser_tag_tagged(parser_build_conte
     }
 
     std::string trigger_marker       = !format.section_start.empty() ? format.section_start : format.per_call_start;
-    auto        content_before_tools = trigger_marker.empty() ? p.eps() : p.until(trigger_marker);
+    auto        content_before_tools = trigger_marker.empty() ?
+        p.eps() :
+        (opener_optional ? p.until_one_of({ trigger_marker, function.name_prefix }) : p.until(trigger_marker));
     return ctx.reasoning_parser + p.optional(p.content(content_before_tools)) + tool_calls + p.end();
 }
 
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 4b28033d..d1006322 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -705,6 +705,12 @@ private:
 
     bool sleeping = false;
 
+    // Pristine copy of the params used for the first load. The fit pass in
+    // common_init_from_params mutates params_base (tensor_buft_overrides,
+    // tensor_split) with values that reference backend state, so reloads
+    // after sleeping must start from this copy (see handle_sleeping_state).
+    common_params params_launch;
+
     void destroy() {
         llama_init.reset();
 
@@ -741,7 +747,14 @@ private:
             destroy();
         } else {
             SRV_INF("%s", "server is exiting sleeping state\n");
-            if (!load_model(params_base)) {
+            // Reload from a pristine copy of the launch params: the previous
+            // load's fit pass wrote tensor_buft_overrides/tensor_split into
+            // params_base and those reference backend state destroyed when
+            // entering sleep. Re-using them makes the fit abort ("already set
+            // by user") and the subsequent model load crash on stale buffer
+            // type pointers.
+            common_params params_fresh = params_launch;
+            if (!load_model(params_fresh)) {
                 GGML_ABORT("failed to reload model after sleeping");
             }
         }
@@ -755,6 +768,12 @@ private:
 
         SRV_INF("loading model '%s'\n", params.model.path.c_str());
 
+        if (!is_resume) {
+            // keep a pristine copy for reloads after sleeping (the fit pass
+            // below mutates params_base)
+            params_launch = params;
+        }
+
         params_base = params;
 
         llama_init = common_init_from_params(params_base);
-- 
