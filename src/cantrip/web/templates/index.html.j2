<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cantrip{% if charm_name %} — {{ charm_name }}{% endif %}</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header>
    <div class="header-left">
      <h1>Cantrip</h1>
      {% if charm_name %}<span class="charm-name">{{ charm_name }}</span>{% endif %}
    </div>
    <div class="header-right">
      <span id="lifecycle-badge" class="lifecycle-badge lifecycle-running"
            role="status" aria-live="polite"
            aria-label="Autonomous loop state"
            hidden></span>
      <span id="short-session-badge" class="short-session-badge"
            role="status" aria-live="polite"
            aria-label="Short-session mode active"
            title="Short-session mode: aggressive compaction and a near-fresh conversation each turn — context is intentionally forgetful"
            hidden>[short-session]</span>
      <span id="cache-indicator" class="cache-indicator"
            role="status" aria-live="polite" aria-label="Prompt cache"
            hidden></span>
      <button id="btn-help" type="button" class="header-btn"
              aria-label="Help" aria-expanded="false" aria-controls="help-overlay"
              onclick="cantrip.toggleHelp()">?</button>
      <button id="btn-logs" type="button" class="header-btn"
              aria-label="Logs" aria-expanded="false" aria-controls="logs-overlay"
              onclick="cantrip.toggleLogs()">Logs</button>
      <button id="btn-graph" type="button" class="header-btn"
              aria-label="Graph" aria-expanded="false" aria-controls="graph-overlay"
              onclick="cantrip.toggleGraph()">Graph</button>
      <span id="connection-status" class="status-dot disconnected"
            role="status" aria-label="Disconnected"></span>
    </div>
  </header>

  <div id="update-banner" class="update-banner" role="region"
       aria-label="Newer Cantrip available" hidden>
    <div id="update-banner-body" class="update-banner-body"></div>
    <div class="update-banner-buttons">
      <a id="update-banner-link" class="update-btn primary" href="#"
         target="_blank" rel="noopener">Open PyPI</a>
      <button type="button" id="update-banner-dismiss" class="update-btn"
              aria-label="Dismiss update notice">Dismiss</button>
    </div>
  </div>

  <main>
    <section id="chat-panel" aria-label="Chat">
      <label for="chat-input" class="visually-hidden">Describe what you want to build</label>
      <div id="resume-banner" class="resume-banner" role="region"
           aria-label="Resume previous session" hidden>
        <div id="resume-banner-summary" class="resume-banner-summary"></div>
        <div class="resume-banner-buttons">
          <button type="button" id="resume-btn-resume" class="resume-btn primary">Resume</button>
          <button type="button" id="resume-btn-fresh" class="resume-btn"
                  title="Archive the previous session to .cantrip.bak-<timestamp> and start new">Start fresh</button>
          <button type="button" id="resume-btn-transcript" class="resume-btn"
                  aria-expanded="false" aria-controls="resume-transcript">View transcript</button>
        </div>
        <div id="resume-transcript" class="resume-transcript" hidden></div>
      </div>
      <div id="chat-messages" role="log" aria-live="polite" aria-relevant="additions">
        <div id="chat-empty" class="chat-empty">
          <p class="chat-empty-title">Ready when you are.</p>
          <p class="chat-empty-hint">
            Describe the workload you want to charm — for example,
            <em>a Flask app that speaks PostgreSQL</em> — and
            Cantrip will plan the charm, write the code, and deploy it.
          </p>
        </div>
      </div>
      <button type="button" id="btn-scroll-bottom" class="scroll-bottom-btn"
              aria-label="Scroll to latest message"
              title="Scroll to latest" hidden
              onclick="cantrip.scrollChatToBottom()">↓</button>
      <div id="thinking-indicator" role="status" aria-live="polite" hidden>
        <span class="dots"></span>
        <span id="thinking-label"> Thinking&hellip;</span>
        <button type="button" id="btn-cancel" class="cancel-btn"
                aria-label="Cancel the in-flight request"
                onclick="cantrip.cancelTurn()">Cancel</button>
      </div>
      <form id="chat-form" autocomplete="off">
        <textarea id="chat-input" rows="1"
                  placeholder="Describe what you want to build&hellip; (Shift+Enter for newline)"
                  autofocus></textarea>
        <button type="submit">Send</button>
      </form>
    </section>

    <section id="right-panels" aria-label="Workspace">
      <section id="preflight-panel" aria-labelledby="preflight-heading" hidden>
        <div class="panel-header">
          <h2 id="preflight-heading">Preparing environment</h2>
        </div>
        <ul id="preflight-list" role="list"></ul>
      </section>

      <section id="task-panel" aria-labelledby="tasks-heading">
        <h2 id="tasks-heading">Tasks</h2>
        <div id="task-list">
          {% for task in tasks %}
          <div class="task task-{{ task.status }}" id="task-{{ task.id }}" data-category="{{ task.category }}">
            <span class="task-icon"></span>
            <span class="task-title">{{ task.title }}</span>
            <span class="task-badge">{{ task.category }}</span>
            {% if task.worktree_path %}
            <span class="task-worktree">worktree: {{ task.worktree_path }}</span>
            {% endif %}
          </div>
          {% endfor %}
          {% if not tasks %}
          <div class="task-empty">No tasks yet.</div>
          {% endif %}
        </div>
      </section>

      <section id="juju-panel" aria-labelledby="juju-heading">
        <div class="panel-header">
          <h2 id="juju-heading">Juju Status</h2>
          <button type="button" id="btn-juju-refresh" class="panel-btn"
                  aria-label="Refresh Juju status"
                  title="Refresh (Alt+R)"
                  onclick="cantrip.refreshJujuStatus()">⟳</button>
        </div>
        <div id="juju-apps">
          <div class="juju-empty">No model connected.</div>
        </div>
      </section>
    </section>
  </main>

  <!-- Help overlay -->
  <div id="help-overlay" class="overlay hidden"
       role="dialog" aria-modal="true" aria-labelledby="help-overlay-title">
    <div class="overlay-content">
      <h2 id="help-overlay-title" tabindex="-1">Keyboard Shortcuts</h2>
      <dl class="shortcuts-list">
        <dt><kbd>Alt</kbd>+<kbd>H</kbd></dt><dd>Toggle this help</dd>
        <dt><kbd>Alt</kbd>+<kbd>L</kbd></dt><dd>Toggle log viewer</dd>
        <dt><kbd>Alt</kbd>+<kbd>G</kbd></dt><dd>Toggle integration graph</dd>
        <dt><kbd>Alt</kbd>+<kbd>R</kbd></dt><dd>Refresh Juju status (or graph, when open)</dd>
        <dt><kbd>Esc</kbd></dt><dd>Close overlay</dd>
        <dt><kbd>Enter</kbd></dt><dd>Send message</dd>
        <dt><kbd>Shift</kbd>+<kbd>Enter</kbd></dt><dd>Newline in chat input</dd>
      </dl>
      <p class="overlay-hint">Press Escape to close</p>
    </div>
  </div>

  <!-- Logs overlay -->
  <div id="logs-overlay" class="overlay hidden"
       role="dialog" aria-modal="true" aria-labelledby="logs-overlay-title">
    <div class="overlay-content overlay-wide">
      <h2 id="logs-overlay-title" tabindex="-1">Juju Logs</h2>
      <pre id="logs-output" class="logs-pre">Loading...</pre>
      <p class="overlay-hint">Press Escape or Alt+L to close</p>
    </div>
  </div>

  <!-- Graph overlay -->
  <div id="graph-overlay" class="overlay hidden"
       role="dialog" aria-modal="true" aria-labelledby="graph-overlay-title">
    <div class="overlay-content overlay-wide">
      <h2 id="graph-overlay-title" tabindex="-1">Integration Graph</h2>
      <div id="graph-view" class="graph-view">
        <div class="juju-empty">Loading&hellip;</div>
      </div>
      <p class="overlay-hint">Press Escape or Alt+G to close &middot; Alt+R to refresh</p>
    </div>
  </div>

  <footer>
    <span id="status-label"></span>
    <span id="status-spacer"></span>
    <span class="footer-hint">Alt+H Help &middot; Alt+L Logs &middot; Alt+G Graph &middot; Alt+R Refresh</span>
  </footer>

  <script src="/static/cantrip.js"></script>
  <script>
    cantrip.connect({{ port }});
  </script>
</body>
</html>
