/* Cantrip TUI Styles */

Screen {
    background: $surface;
}

#main-container {
    height: 1fr;
}

#left-panel {
    width: 1fr;
    padding: 1;
}

#right-panel {
    width: 35%;
    min-width: 30;
    border-left: solid $surface-lighten-1;
    padding: 1;
}

/* Phase 108.1: sub-panels separate by whitespace + a bold heading
 * rather than by a coloured rule.  ``border-bottom`` is gone; the
 * trailing ``padding-bottom: 1`` plus ``margin-bottom: 1`` is the
 * gap that does the work. */
#task-checklist {
    height: auto;
    max-height: 50%;
    overflow-y: auto;
    padding-bottom: 1;
    margin-bottom: 1;
}

/* ``height: 1fr`` is load-bearing — without it the pane resolves to
 * height 0 and the file tree disappears, even though the widget's
 * ``DEFAULT_CSS`` also declares ``1fr`` (the user CSS specificity
 * wins, so omitting it here drops the value).  ``max-height: 50%``
 * caps the share so it doesn't elbow out ``#juju-status`` when
 * that pane is visible. */
#charm-files {
    height: 1fr;
    max-height: 50%;
    padding-bottom: 1;
    margin-bottom: 1;
}

/* The widget hides itself entirely while no model is connected
 * (Phase 65 finding G), so ``1fr`` here doesn't claim space for an
 * empty pane — the layout passes the residual to ``#charm-files``
 * via its 1fr instead.  When the pane *is* visible, ``1fr`` and
 * ``overflow-y: auto`` together let the user scroll through the
 * apps if dev + expanded-COS overruns the allocated share. */
#juju-status {
    height: 1fr;
    overflow-y: auto;
}

#chat {
    height: 1fr;
    overflow-y: auto;
}

#chat-history {
    height: 100%;
}

#chat-input {
    dock: bottom;
    margin-top: 1;
}

/* Phase 69.3: Ctrl-X shell mode tints the input border so it is
 * unmistakable that Enter routes to a subprocess, not the agent. */
#chat-input.-shell-mode {
    border: tall $warning;
}

/* Status indicators */
.status-active {
    color: $success;
}

.status-waiting {
    color: $warning;
}

.status-blocked {
    color: $error;
}

.status-maintenance {
    color: $primary;
}

/* Thinking indicator (Phase 108.7) — sized for the single-line
 * ``ThinkingIndicator`` widget rather than the stock 3-row
 * ``LoadingIndicator`` it replaced.  Margin keeps the spinner
 * from sitting flush against the previous chat row. */
#thinking-indicator {
    height: 1;
    margin: 1 0;
}

/* Log viewer screen — Phase 108.1: the modal already carries a
 * frame; an inner border around the log body is double-chrome. */
#log-output {
    overflow-y: auto;
}

/* Trace/debug screen */
#trace-container {
    overflow-y: auto;
}
