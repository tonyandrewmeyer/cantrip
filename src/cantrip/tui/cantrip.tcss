/* Cantrip TUI Styles */

Screen {
    background: $surface;
}

#main-container {
    height: 1fr;
}

#left-panel {
    width: 1fr;
    padding: 1;
}

#right-panel {
    width: 35%;
    min-width: 30;
    border-left: solid $primary;
    padding: 1;
}

/* The TaskChecklistWidget already declares height/max-height in its
 * DEFAULT_CSS; only the right-panel-specific divider lives here. */
#task-checklist {
    overflow-y: auto;
    border-bottom: solid $primary;
    padding-bottom: 1;
    margin-bottom: 1;
}

/* max-height caps it; height: 1fr would be redundant. */
#charm-files {
    max-height: 50%;
    border-bottom: solid $primary;
    padding-bottom: 1;
    margin-bottom: 1;
}

/* Auto-sized — the widget hides itself entirely while no model is
 * connected, so 1fr would either claim space for a hidden block or
 * leave a fixed gap once it shows up. */
#juju-status {
    height: auto;
    overflow-y: auto;
}

#chat {
    height: 1fr;
    overflow-y: auto;
}

#chat-history {
    height: 100%;
}

#chat-input {
    dock: bottom;
    margin-top: 1;
}

/* Status indicators */
.status-active {
    color: $success;
}

.status-waiting {
    color: $warning;
}

.status-blocked {
    color: $error;
}

.status-maintenance {
    color: $primary;
}

/* Thinking indicator in chat */
#thinking-indicator {
    height: 3;
    margin: 1 0;
}

/* Log viewer screen */
#log-output {
    border: solid $primary;
    overflow-y: auto;
}

/* Trace/debug screen */
#trace-container {
    overflow-y: auto;
}
