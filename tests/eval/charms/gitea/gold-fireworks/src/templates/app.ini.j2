; Gitea configuration — generated by the Juju charm.
;
; This Jinja2 template documents the shape of the ``app.ini`` the
; charm writes to ``/data/gitea/conf/app.ini``.  The charm currently
; concatenates the file inline in ``GiteaK8SCharm._generate_config``
; (src/charm.py); this template mirrors that shape so future
; refactors can switch to Jinja rendering without changing the
; emitted file.

[server]
APP_NAME = {{ app_name | default("Gitea") }}
HTTP_PORT = 3000
ROOT_URL = {{ root_url | default("http://localhost:3000/") }}
DISABLE_SSH = true

[database]
DB_TYPE = postgres
HOST = {{ db.host }}:{{ db.port | default("5432") }}
NAME = {{ db.dbname | default("gitea") }}
USER = {{ db.user }}
PASSWD = {{ db.password }}
SCHEMA = public

{% if redis_url %}
[cache]
ADAPTER = redis
HOST = {{ redis_url }}

[session]
PROVIDER = redis
PROVIDER_CONFIG = {{ redis_url }}
{% endif %}

{% if s3 %}
[storage.lfs]
STORAGE_TYPE = minio
MINIO_ENDPOINT = {{ s3.endpoint }}
MINIO_ACCESS_KEY_ID = {{ s3.access_key }}
MINIO_SECRET_ACCESS_KEY = {{ s3.secret_key }}
MINIO_BUCKET = {{ s3.bucket }}
MINIO_USE_SSL = {{ s3.use_ssl | default("true") }}
{% endif %}

{% if smtp %}
[mailer]
ENABLED = true
SMTP_ADDR = {{ smtp.host }}
SMTP_PORT = {{ smtp.port | default("587") }}
USER = {{ smtp.user }}
PASSWD = {{ smtp.password }}
FROM = {{ smtp.from | default("gitea@localhost") }}
{% endif %}

[security]
INSTALL_LOCK = true
DISABLE_GIT_HOOKS = {{ disable_git_hooks | default("true") }}

[log]
LEVEL = {{ log_level | default("info") }}

[metrics]
ENABLED = true
