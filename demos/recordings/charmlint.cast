[7.252156, "o", "\u001b[2mcharmcraft.yaml\u001b[0m \u001b[1;33mACT001\u001b[0m Missing 'get-health' action (or alias: health-check, check-health, get-status, health)\r\n\u001b[2mcharmcraft.yaml\u001b[0m \u001b[1;33mACT002\u001b[0m Missing 'pause' action (or alias: stop, disable)\r\n"]
[7.2522, "o", "\u001b[2mcharmcraft.yaml\u001b[0m \u001b[1;33mACT003\u001b[0m Missing 'resume' action (or alias: start, enable)\r\n\u001b[1;36mCFG005\u001b[0m Charm declares config options but never references BlockedStatus — invalid config has no visible status\r\n\u001b[1;33mDOC001\u001b[0m No README.md found\r\n\u001b[1;33mDOC002\u001b[0m No installation/setup documentation found\r\n\u001b[1;36mDOC003\u001b[0m No configuration documentation found\r\n\u001b[1;36mDOC004\u001b[0m No usage documentation found\r\n\u001b[1;36mDOC005\u001b[0m No troubleshooting documentation found\r\n\u001b[2mcharmcraft.yaml\u001b[0m \u001b[1;33mMETA002\u001b[0m Missing 'display-name' field\r\n"]
